{
    "$schema": "https://turborepo.dev/schema.json",
    "globalDependencies": [
        ".env"
    ],
    "globalEnv": [
        "NODE_ENV",
        "PORT",
        "WS_PORT",
        "FRONTEND_ORIGIN",
        "WEBSOCKET_SERVER",
        "USE_SSL_WEBSOCKET",
        "SSL_CERT",
        "SSL_KEY",
        "DATABASE_URL",
        "NEXTAUTH_SECRET",
        "JWT_SIGNING_PRIVATE_KEY",
        "DEV_PASSWORD",
        "WEBRTC_STUN_SERVER_URL",
        "WEBRTC_TURN_SERVER_URL",
        "WEBRTC_TURN_SECRET",
        "WEBSOCKET_CORS_REGEX",
        "NEXT_PUBLIC_APP_ENV",
    ],
    "tasks": {
        "vercel-build": {
            "dependsOn": ["^db:migrate:deploy", "necode:build"]
        },
        "necode:build": {
            "dependsOn": ["~database#generate"],
            "outputs": [".next/**"]
        },
        "db:migrate:deploy": {
            "dependsOn": ["generate"],
            "env": ["DATABASE_URL"],
            "cache": false
        },
        "db:push": {
            "cache": false
        },
        "db:migrate:dev": {
            "cache": false
        },
        "db:seed": {},
        "dev": {
            "cache": false
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "generate": {
            "dependsOn": ["^generate"],
            "cache": false
        },
        "validate": {
            "dependsOn": ["lint", "typecheck"]
        },
        "wsserver:build": {},
        "typecheck": {},
        "lint": {},
        "lint:fix": {}
    }
}